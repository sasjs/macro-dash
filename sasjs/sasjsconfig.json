{
  "$schema": "https://raw.githubusercontent.com/sasjs/utils/main/src/types/sasjsconfig-schema.json",
  "streamConfig": {
    "streamWeb": true,
    "streamWebFolder": "web",
    "webSourcePath": "src",
    "streamServiceName": "MacroDash",
    "streamLogo": "macrodash.png"
  },
  "macroFolders": [
    "sasjs/macros"
  ],
  "serviceConfig": {
    "serviceFolders": [
      "sasjs/services/common"
    ]
  },
  "defaultTarget": "local",
  "targets": [
    {
      "name": "local",
      "serverUrl": "http://localhost:5000",
      "serverType": "SASJS",
      "httpsAgentOptions": {
        "allowInsecureRequests": true
      },
      "appLoc": "/Public/app/macrodash",
      "deployConfig": {
        "deployServicePack": true,
        "deployScripts": []
      }
    },
    {
      "name": "viya",
      "serverUrl": "",
      "serverType": "SASVIYA",
      "httpsAgentOptions": {
        "allowInsecureRequests": false
      },
      "appLoc": "/Users/viyademo18/macrodash",
      "contextName": "Compute Reusable",
      "sasjsBuildFolder": "sasjsrelease/viya"
    },
    {
      "name": "sas9",
      "serverUrl": "",
      "serverType": "SAS9",
      "appLoc": "/Public/app/macrodash",
      "serverName": "SASApp",
      "repositoryName": "Foundation"
    },
    {
      "name": "mock",
      "serverUrl": "",
      "serverType": "SASJS",
      "appLoc": "/Public/app/macrodash",
      "serviceConfig": {
        "serviceFolders": [
          "sasjs/mocks/sasjs/services/common"
        ]
      },
      "streamConfig": {
        "mockWeb": true,
        "mockWebFolder": "sasjsbuild/mock",
        "streamWeb": false,
        "webSourcePath": "src"
      }
    },
    {
      "name": "server",
      "serverUrl": "",
      "serverType": "SASJS",
      "httpsAgentOptions": {
        "allowInsecureRequests": false
      },
      "appLoc": "/Public/app/macrodash",
      "serviceConfig": {
        "serviceFolders": [
          "sasjs/services/common",
          "sasjs/mocks/sasjs/services/common"
        ]
      },
      "deployConfig": {
        "deployServicePack": true,
        "deployScripts": []
      },
      "sasjsBuildFolder": "sasjsrelease/server"
    }
  ],
  "release": {
    "assets": [
      {
        "path": "sasjsrelease/viya/viya.sas",
        "name": "macro-dash-viya.sas",
        "label": "SASjs Viya App"
      },
      {
        "path": "sasjsrelease/viya/viya.json.zip",
        "name": "macro-dash-viya.json.zip",
        "label": "SASjs Viya App, streamed"
      },
      {
        "path": "sasjsrelease/server/server.json.zip",
        "name": "macro-dash-server.json.zip",
        "label": "SASjs Server App"
      }
    ]
  }
}
