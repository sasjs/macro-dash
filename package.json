{
  "name": "macro-dash",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "test": "node test/reachability.js",
    "test:e2e": "node test/e2e/run.js",
    "start": "cd src && python3 -m http.server 8000",
    "devsetup": "node scripts/devsetup.js",
    "deploy": "sasjs cbd -t local",
    "mock:build": "sasjs compile -t mock && sasjs build -t mock",
    "mock:deploy": "node scripts/deploy-mocks.js",
    "prepare": "npm run adapter",
    "semantic-release": "semantic-release",
    "adapter": "cp node_modules/@sasjs/adapter/dist/sasjs-adapter.js src/sasjs.js",
    "audit:gate": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@sasjs/cli": "6.30.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "9.2.6",
    "@semantic-release/npm": "13.2.0",
    "conventional-changelog-conventionalcommits": "7.0.2",
    "playwright": "1.62.1",
    "semantic-release": "25.0.9"
  },
  "dependencies": {
    "@sasjs/adapter": "6.1.0",
    "@sasjs/core": "5.1.0"
  }
}
